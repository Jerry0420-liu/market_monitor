# Copy to .env for local development. Do not put secrets in this file.
MARKET_MONITOR_ENV=development
MARKET_MONITOR_DATA_DIR=./var/data
MARKET_MONITOR_OWNER_PASSWORD=<set-a-local-owner-password>
# Or use MARKET_MONITOR_OWNER_PASSWORD_FILE with one bounded UTF-8 secret file.
MARKET_MONITOR_BIND_HOST=127.0.0.1
MARKET_MONITOR_PORT=8000
MARKET_MONITOR_WORKERS=1
MARKET_MONITOR_DELIVERY_POLL_SECONDS=1
MARKET_MONITOR_WORKER_POLL_SECONDS=1
MARKET_MONITOR_TDX_BAR_RETENTION_DAYS=5
# In release mode, build apps/web first; this defaults to apps/web/dist when omitted.
# MARKET_MONITOR_STATIC_ROOT=./apps/web/dist
# MARKET_MONITOR_WEBHOOK_URL=<optional-owner-configured-webhook>
MARKET_MONITOR_WEBHOOK_ENABLED=false
