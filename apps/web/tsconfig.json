{
	"compilerOptions": {
		"composite": true,
		"esModuleInterop": true,
		"jsx": "react-jsx",
		"lib": ["ES2024", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"noEmit": true,
		"skipLibCheck": true,
		"strict": true,
		"target": "ES2024",
		"types": ["vitest/globals", "@testing-library/jest-dom"]
	},
	"include": ["src", "e2e", "playwright.config.ts", "vite.config.ts"]
}
