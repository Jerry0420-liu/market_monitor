# Non-secret staged production configuration.
MARKET_MONITOR_ENV=production
MARKET_MONITOR_DATA_DIR=/var/lib/market-monitor
MARKET_MONITOR_BIND_HOST=127.0.0.1
MARKET_MONITOR_PORT=8000
MARKET_MONITOR_WORKERS=1
MARKET_MONITOR_ALLOWED_HOSTS=127.0.0.1,localhost
MARKET_MONITOR_OWNER_PASSWORD_FILE=/run/secrets/owner_password
MARKET_MONITOR_WEBHOOK_ENABLED=false

# Hard gates remain closed until the post-Shadow Owner activation procedure.
MARKET_MONITOR_OFFICIAL_ENABLED=false
MARKET_MONITOR_THRESHOLD_ACTIVATION=0

# Populate only with approved local artifacts before an enabled official run.
MARKET_MONITOR_TRADING_CALENDAR_FILE=/etc/market-monitor/calendar.json
MARKET_MONITOR_LISTING_REFERENCE_FILE=/etc/market-monitor/listing-reference.json
# MARKET_MONITOR_OFFICIAL_SUBJECT_UID=<approved-sector-subject-uid>
# MARKET_MONITOR_TDX_SERVERS=<host:port,host:port>
