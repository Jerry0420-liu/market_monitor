{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Market Monitor staged production environment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "MARKET_MONITOR_ENV",
    "MARKET_MONITOR_DATA_DIR",
    "MARKET_MONITOR_OWNER_PASSWORD_FILE",
    "MARKET_MONITOR_OFFICIAL_ENABLED",
    "MARKET_MONITOR_THRESHOLD_ACTIVATION"
  ],
  "properties": {
    "MARKET_MONITOR_ENV": {
      "const": "production"
    },
    "MARKET_MONITOR_DATA_DIR": {
      "type": "string",
      "minLength": 1
    },
    "MARKET_MONITOR_OWNER_PASSWORD_FILE": {
      "type": "string",
      "minLength": 1
    },
    "MARKET_MONITOR_BIND_HOST": {
      "const": "127.0.0.1",
      "default": "127.0.0.1"
    },
    "MARKET_MONITOR_PORT": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535,
      "default": 8000
    },
    "MARKET_MONITOR_WORKERS": {
      "const": 1
    },
    "MARKET_MONITOR_WEBHOOK_ENABLED": {
      "const": false
    },
    "MARKET_MONITOR_OFFICIAL_ENABLED": {
      "const": false,
      "description": "Owner activation is not part of staged deployment."
    },
    "MARKET_MONITOR_THRESHOLD_ACTIVATION": {
      "const": 0,
      "description": "No production threshold activation before Owner review."
    },
    "MARKET_MONITOR_TRADING_CALENDAR_FILE": {
      "type": "string",
      "minLength": 1
    },
    "MARKET_MONITOR_LISTING_REFERENCE_FILE": {
      "type": "string",
      "minLength": 1
    },
    "MARKET_MONITOR_OFFICIAL_SUBJECT_UID": {
      "type": "string",
      "minLength": 1
    },
    "MARKET_MONITOR_TDX_SERVERS": {
      "type": "string",
      "minLength": 1
    }
  }
}
